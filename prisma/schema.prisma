// This is your Prisma schema file
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─── Auth ───

model User {
  id           String    @id @default(cuid())
  name         String
  email        String?   @unique
  phone        String?   @unique
  passwordHash String
  role         Role      @default(STUDENT)
  active       Boolean   @default(true)
  address      String?
  dateOfBirth  DateTime?
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  enrollments           Enrollment[]
  progress              Progress[]
  submissions           Submission[]
  announcements         Announcement[]     @relation("Author")
  coursesCreated        Course[]           @relation("Instructor")
  coInstructorOf        CourseInstructor[] @relation("CoInstructor")
  sessionsAsInstructor  ClassSession[]     @relation("SessionInstructor")
  seriesAsInstructor    SessionSeries[]    @relation("SessionInstructor")
  sessionAttendances    SessionAttendee[]  @relation("SessionStudent")
  availability          Availability[]
  blockedDates          BlockedDate[]
  notifications         Notification[]
  guardianLinks         GuardianStudent[]  @relation("Guardian")
  studentLinks          GuardianStudent[]  @relation("Student")
  reportsReceived       StudentReport[]    @relation("ReportStudent")
  reportsWritten        StudentReport[]    @relation("ReportAuthor")
}

enum Role {
  ADMIN
  INSTRUCTOR
  STUDENT
  GUARDIAN
}

// Links a guardian to one or more students
model GuardianStudent {
  id         String  @id @default(cuid())
  guardianId String
  guardian   User    @relation("Guardian", fields: [guardianId], references: [id], onDelete: Cascade)
  studentId  String
  student    User    @relation("Student", fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([guardianId, studentId])
}

// ─── Course Structure ───

model Course {
  id             String         @id @default(cuid())
  title          String
  description    String?
  coverImageUrl  String?
  visibility     Visibility     @default(DRAFT)
  enrollmentMode EnrollmentMode @default(OPEN)
  inviteCode     String?        @unique

  instructorId String
  instructor   User   @relation("Instructor", fields: [instructorId], references: [id])

  coInstructors CourseInstructor[]

  modules       Module[]
  enrollments   Enrollment[]
  announcements Announcement[]
  sessions      ClassSession[]
  series        SessionSeries[]
  availability  Availability[]
  reports       StudentReport[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Additional teachers who can manage a course alongside the owner
model CourseInstructor {
  id       String   @id @default(cuid())
  courseId String
  course   Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  userId   String
  user     User     @relation("CoInstructor", fields: [userId], references: [id], onDelete: Cascade)
  addedAt  DateTime @default(now())

  @@unique([courseId, userId])
}

enum Visibility {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum EnrollmentMode {
  OPEN
  INVITE_CODE
  MANUAL
}

model Module {
  id       String   @id @default(cuid())
  title    String
  order    Int
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons  Lesson[]
  reports  StudentReport[]
}

model Lesson {
  id       String     @id @default(cuid())
  title    String
  content  String?
  type     LessonType @default(TEXT)
  order    Int
  duration Int?
  moduleId String
  module   Module     @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  resources  Resource[]
  progress   Progress[]
  assignment Assignment?
  sessions   ClassSession[]
  series     SessionSeries[]
  reports    StudentReport[]
}

enum LessonType {
  TEXT
  VIDEO
  FILE
  MIXED
}

model Resource {
  id       String       @id @default(cuid())
  title    String
  url      String
  type     ResourceType @default(LINK)
  lessonId String
  lesson   Lesson       @relation(fields: [lessonId], references: [id], onDelete: Cascade)
}

enum ResourceType {
  LINK
  VIDEO
  DOCUMENT
}

// ─── Enrollment ───

model Enrollment {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId    String
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  enrolledAt DateTime @default(now())

  @@unique([userId, courseId])
}

// ─── Progress ───

model Progress {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId    String
  lesson      Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  completed   Boolean   @default(false)
  completedAt DateTime?

  @@unique([userId, lessonId])
}

// ─── Scheduling ───

model Availability {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  dayOfWeek Int
  startTime String
  endTime   String
  courseId  String?
  course    Course?  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  active    Boolean  @default(true)

  @@unique([userId, dayOfWeek, startTime, courseId])
}

model BlockedDate {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime
  reason    String?
  createdAt DateTime @default(now())
}

model ClassSession {
  id           String        @id @default(cuid())
  courseId     String
  course       Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  instructorId String
  instructor   User          @relation("SessionInstructor", fields: [instructorId], references: [id])
  lessonId     String?
  lesson       Lesson?       @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  title        String
  description  String?
  date         DateTime
  startTime    String
  endTime      String
  location     String?
  status       SessionStatus @default(SCHEDULED)
  cancelReason String?
  seriesId     String?
  series       SessionSeries? @relation(fields: [seriesId], references: [id], onDelete: SetNull)
  seriesWeek   Int?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  attendees SessionAttendee[]
}

enum SessionStatus {
  SCHEDULED
  CANCELLED
  COMPLETED
}

model SessionAttendee {
  id         String            @id @default(cuid())
  sessionId  String
  session    ClassSession      @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  studentId  String
  student    User              @relation("SessionStudent", fields: [studentId], references: [id], onDelete: Cascade)
  attendance AttendanceStatus?
  notes      String?
  recordedAt DateTime?

  @@unique([sessionId, studentId])
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
}

// ─── Notifications ───

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String?
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
}

// ─── Assignments Module ───

model Assignment {
  id          String    @id @default(cuid())
  lessonId    String    @unique
  lesson      Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  title       String
  description String?
  dueDate     DateTime?

  submissions Submission[]
}

model Submission {
  id           String           @id @default(cuid())
  assignmentId String
  assignment   Assignment       @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  userId       String
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  textContent  String?
  linkUrl      String?
  status       SubmissionStatus @default(SUBMITTED)
  grade        Float?
  feedback     String?
  submittedAt  DateTime         @default(now())
  reviewedAt   DateTime?
  isLate       Boolean          @default(false)

  @@unique([assignmentId, userId])
}

enum SubmissionStatus {
  SUBMITTED
  REVIEWED
  NEEDS_REVISION
}

// ─── Student Reports ───

model StudentReport {
  id        String   @id @default(cuid())
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  studentId String
  student   User     @relation("ReportStudent", fields: [studentId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation("ReportAuthor", fields: [authorId], references: [id])
  moduleId  String?
  module    Module?  @relation(fields: [moduleId], references: [id], onDelete: SetNull)
  lessonId  String?
  lesson    Lesson?  @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([courseId, studentId])
}

// ─── Session Series (recurring sessions) ───

model SessionSeries {
  id           String   @id @default(cuid())
  courseId     String
  course       Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  instructorId String
  instructor   User     @relation("SessionInstructor", fields: [instructorId], references: [id])
  title        String
  description  String?
  lessonId     String?
  lesson       Lesson?  @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  location     String?
  startTime    String
  endTime      String
  startDate    DateTime
  repeatWeeks  Int      @default(1)
  sessions     ClassSession[]
  exceptions   SessionSeriesException[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model SessionSeriesException {
  id         String   @id @default(cuid())
  seriesId   String
  series     SessionSeries @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  weekNumber Int
  reason     String?
  createdAt  DateTime @default(now())

  @@unique([seriesId, weekNumber])
}

// ─── Announcements Module ───

model Announcement {
  id        String   @id @default(cuid())
  courseId   String
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation("Author", fields: [authorId], references: [id])
  title     String
  body      String
  pinned    Boolean  @default(false)
  createdAt DateTime @default(now())
}

// ─── App Settings ───

model AppSetting {
  key   String @id
  value String
}

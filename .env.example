# Database
DATABASE_URL="file:./dev.db"

# Auth
# MUST be a strong random value in production (e.g. `openssl rand -base64 32`).
# A guessable secret lets anyone forge session tokens and impersonate an admin.
AUTH_SECRET="replace-with-a-random-string"
NEXTAUTH_URL="http://localhost:3000"

# Superadmin login (no seeding required)
# The admin logs in with these credentials directly — the account is provisioned
# automatically on first login. Change these to change the admin login. Must be
# set in the running app's env: .env.local for local dev, host env in production.
SUPERADMIN_EMAIL=""
SUPERADMIN_PASSWORD=""
